    borderRadius: 4,
    overflow: "hidden",
    border: `1px solid ${paperDeep}`,
    boxShadow: "0 4px 12px rgba(28,26,23,0.1)",
  },
  thumb: { width: "100%", height: "100%", objectFit: "cover", display: "block" },
  thumbRemove: {
    position: "absolute",
    top: 4,
    right: 4,
    width: 24,
    height: 24,
    borderRadius: "50%",
    background: "rgba(28,26,23,0.82)",
    color: paper,
    border: "none",
    fontSize: 17,
    lineHeight: 1,
    cursor: "pointer",
    display: "flex",
