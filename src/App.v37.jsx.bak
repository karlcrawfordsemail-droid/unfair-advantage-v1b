import React, { useState, useRef, useEffect } from "react";

// ─────────────────────────────────────────────────────────────
//  WHAT'S IT WORTH — dual-mode valuation prototype (Buy / Sell)
//  Same engine, two presentations. Auto-detects local vs.
//  collectible. Zip is per-transaction (where the sale is).
// ─────────────────────────────────────────────────────────────

function buildSystemPrompt(mode, zip) {
  const zipLine = zip
    ? `The transaction is happening in ZIP code ${zip}. For common local-market goods, factor in that area's typical resale/yard-sale pricing.`
    : `No ZIP was given. Price common local goods at general US yard-sale/resale levels.`;

  const modeLine =
    mode === "sell"
      ? `The user is the SELLER. Their goal is to get the MOST money. Lead the advice toward pricing high but realistic, presentation, and cleanup.`
      : `The user is the BUYER (e.g. at someone else's yard/estate sale). Their goal is to pay the LEAST. Lead the advice toward the walk-away price and negotiation leverage.`;

  return `You are an expert appraiser and resale dealer. You evaluate items the way a seasoned dealer does. You have a web search tool — USE IT before pricing.

${modeLine}
${zipLine}

PROCESS (in order):

1. IDENTIFY from the photos: what it is, maker/signature, era, material. Read marks carefully but do NOT overstate certainty — if ambiguous, say so.

2. DECIDE THE PRICING BASIS (this is critical):
   - COMMON LOCAL-MARKET item (furniture, household goods, décor, tools, toys, common glassware — things that sell locally, not to collectors): price for LOCAL sale. ZIP matters here. These move for a fraction of retail.
   - COLLECTIBLE / NATIONAL-MARKET item (identifiable maker, art pottery, antiques, sought brands, anything with a real online collector market): price to the NATIONAL market. ZIP is irrelevant. If this is a collectible worth notably more than local yard-sale money, SAY SO — tell a seller to sell it online instead of dumping it locally, and alert a buyer that it's a score.
   - SPECIFIC-BUYER item (branded/personalized goods still relevant to a named active party, machine parts, club/team items): do NOT price as worthless commodity. Price against that buyer's REPLACEMENT COST (fraction of what they'd pay new). If the user's notes say a specific buyer exists, weight that heavily.

3. SEARCH THE WEB before pricing — but SCALE YOUR EFFORT to the item:
   - COMMON LOCAL item (everyday household goods, décor, common furniture/tools/toys) → do just 1-2 quick searches to confirm a rough local resale range. Do NOT over-research; speed matters more than precision here, and these move for small money.
   - COLLECTIBLE / SPECIFIC-BUYER / anything with a named maker, mark, or signature → do a THOROUGH search (multiple queries by maker, model, features, sold results). Accuracy is the whole value here and the user will wait for it.
   Prefer actual SOLD/auction results over asking prices. Reason over the SPREAD: a tight cluster = the real market; a lone high price = fantasy, distrust it.

4. SET CONFIDENCE honestly: GOOD data (comps agree) → tighter range, High. THIN data → wider range, Moderate. NO data → wide ballpark, Low, and say it can't be pinned down without more info. Never fabricate comps.

5. CONDITION drives price HARD — weight it heavily, and let it OVERRIDE an otherwise strong identification. A confirmed maker sets the ceiling, but condition decides where in the range the item actually falls:
   - Heavy damage (deep pitting, rust, dead/chipped edge, cracks, repairs, material degradation, missing parts) pulls the price to the BOTTOM of the range or below it — even for a desirable, correctly-identified maker. An identified but beat-up piece is a display/restoration item, NOT a clean collectible, and must be priced as such.
   - A clean, undamaged example of the same item earns the TOP of the range.
   - Never price a rough example near the top just because the maker is collectible. State plainly in the reasoning when condition is capping the value, and price accordingly.
   - You often can't fully judge condition from a photo — flag what you can't see, and if visible damage is significant, price the visible damage in, don't assume the clean case.

Output ONLY valid JSON, no markdown, no preamble, exactly this shape:
{
  "id": "what it is, likely maker, era, material",
  "itemType": "one of: Local, Collectible, SpecificBuyer",
  "confidence": "High, Moderate, or Low",
  "value": "the realistic market value RANGE like '$40–65' — the honest worth of the item",
  "wholesale": "the WHOLESALE / dealer-buy floor as a range — what a dealer or reseller would realistically PAY to acquire this for resale. Below market value: typically 40–60% of the value range for common goods, higher percentage for hot collectibles that move fast. This is the quick-cash, sell-to-the-trade floor.",
  "listPrice": "what a SELLER should list/ask to get top dollar — at or slightly above the value HIGH end, as a range. Must relate to value: ask low end should sit near the value high end, never float below the value midpoint.",
  "walkAway": "the smart maximum a BUYER should pay to still profit or get a genuine deal — lower-to-mid of the value range, favorable but realistic, as a range",
  "scenarios": [
    { "condition": "short label for the case, e.g. 'If maker is unlisted'", "value": "tighter value range for THIS case", "wholesale": "tighter wholesale/dealer-buy floor for this case", "listPrice": "tighter ask range for this case", "walkAway": "tighter walk-away range for this case" }
  ],
  "reasoning": [
    { "point": "short bold summary (3-6 words)", "detail": "one plain sentence of explanation" }
  ],
  "advice": [
    { "point": "short bold summary (3-6 words)", "detail": "one plain sentence of actionable detail" }
  ],
  "cantVerify": [
    { "point": "short bold summary (3-6 words)", "detail": "one plain sentence: what to check and how much it moves price" }
  ]
}

FORMAT RULES for the arrays:
- Each is a list of 2-4 points. NEVER one big paragraph.
- "point" = a tight bold-able summary a skimmer can read in a glance.
- "detail" = one plain sentence for people who want more.
- reasoning: what comps you found and how they set the price. If it's a collectible worth more than local money, make that a point. If data was thin, say so in a point.
- advice: tailored to mode. SELLER → cleanup/staging/where-to-list to maximize price. BUYER → negotiation angles, flaws to point out, whether to walk. Actionable, specific, not generic.
- cantVerify: specific things you can't confirm from photos that move the price, and what to check.

MANDATORY FIELDS (never omit):
- "wholesale" is REQUIRED on every response and on every scenario. NEVER leave it out. It is the dealer-buy floor — what a dealer/reseller would pay to acquire this for resale — expressed as a range below the market value (roughly 40-60% of value for common goods, higher for fast-moving collectibles). Even when uncertain, give your best wholesale range. A response without "wholesale" is invalid.

SCENARIOS RULE (important):
- Include "scenarios" whenever a specific, identifiable condition would meaningfully change the price — an unconfirmed maker, unknown authenticity, unclear age, condition you can't see, or a specific-buyer question. If such a fork genuinely exists, SHOW IT, even if the main range isn't especially wide.
- Only return "scenarios": [] (empty) when there is NO real conditional — the item is clearly identified, data is solid, and no single unknown would swing the price. Common, well-comped items usually have no fork.
- Give exactly 2 scenarios representing the low case and the high case of that condition.
- Each scenario's ranges MUST be TIGHTER than and sit ENTIRELY INSIDE the main value/listPrice/walkAway ranges. Together the two scenarios should span the main range (low case near the bottom, high case near the top).
- "condition" is a short plain label the user can quickly judge as true or false, e.g. "If maker is unlisted/hobbyist" vs "If maker has exhibition history".
- IMPORTANT: even the HIGH scenario branch must still respect visible condition damage. A confirmed maker on a heavily damaged piece does NOT jump to clean-example prices — the high branch reflects "maker confirmed, in THIS item's actual condition," not "maker confirmed and pristine." Do not let the fork inflate a beat-up item to prices only a clean example would bring.

Give RANGES, never single points. Honesty about uncertainty beats a confident wrong number.`;
}

// Color the confidence badge by level
function confStyle(level) {
  const l = (level || "").toLowerCase();
  if (l.startsWith("high"))
    return { background: "rgba(63,111,95,0.16)", color: "#2c5346" };
  if (l.startsWith("low"))
    return { background: "rgba(124,45,45,0.12)", color: "#7c2d2d" };
  return { background: "rgba(154,123,63,0.16)", color: "#6b5423" };
}

const typeLabel = {
  Local: "Local (yard sale / marketplace)",
  Collectible: "National (online collectors)",
  SpecificBuyer: "Specific buyer (parts / niche)",
};

// Normalize a field that should be an array of {point, detail}.
// Falls back gracefully if the model returns a string or array of strings.
function toPoints(field) {
  if (!field) return [];
  if (Array.isArray(field)) {
    return field
      .map((p) =>
        typeof p === "string"
          ? { point: p, detail: "" }
          : { point: p.point || "", detail: p.detail || "" }
      )
      .filter((p) => p.point || p.detail);
  }
  if (typeof field === "string") return [{ point: "", detail: field }];
  return [];
}

// Renders a list of bold-summary + plain-detail points
function PointList({ points, color }) {
  return (
    <ul style={{ margin: 0, padding: 0, listStyle: "none" }}>
      {points.map((p, i) => (
        <li key={i} style={{ marginBottom: i === points.length - 1 ? 0 : 11 }}>
          {p.point && (
            <span style={{ fontWeight: 700, color: color || "#33302a" }}>
              {p.point}
              {p.detail ? " — " : ""}
            </span>
          )}
          {p.detail && (
            <span style={{ color: "#33302a" }}>{p.detail}</span>
          )}
        </li>
      ))}
    </ul>
  );
}

function App() {
  const [mode, setMode] = useState("sell"); // 'sell' | 'buy'
  const [zip, setZip] = useState("");
  const [photos, setPhotos] = useState([]); // { src, data, mediaType }
  const [notes, setNotes] = useState("");
  const [result, setResult] = useState(null);
  const [costInfo, setCostInfo] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [consent, setConsent] = useState(null); // holds { jobId } when awaiting user choice

  // Loading message tracks (component scope so both evaluate and consent-resume use them).
  const COMMON_MSGS = [
    "Identifying the item…",
    "Checking typical resale prices…",
    "Almost done…",
  ];
  const COLLECTIBLE_MSGS = [
    "Identifying the item…",
    "This looks less common — taking a closer look…",
    "Digging through collector and auction data…",
    "Pulling the best comparables to get you an edge…",
    "Almost there…",
  ];
  const NEUTRAL_OPENER = "Identifying the item…";
  const msgTimersRef = useRef([]);
  const trackAppliedRef = useRef(false);
  const clearTimers = () => {
    msgTimersRef.current.forEach(clearTimeout);
    msgTimersRef.current = [];
  };
  const resetTrack = () => {
    clearTimers();
    trackAppliedRef.current = false;
  };
  const playTrack = (msgs, stepMs) => {
    clearTimers();
    setLoadingMsg(msgs[0]);
    msgTimersRef.current = msgs
      .slice(1)
      .map((text, i) => setTimeout(() => setLoadingMsg(text), stepMs * (i + 1)));
  };
  const applyTrack = (klass) => {
    if (trackAppliedRef.current) return;
    trackAppliedRef.current = true;
    if (klass === "collectible") playTrack(COLLECTIBLE_MSGS, 7000);
    else playTrack(COMMON_MSGS, 3500);
  };
  const [dragActive, setDragActive] = useState(false);
  const [loadingMsg, setLoadingMsg] = useState("");
  const [showIosHint, setShowIosHint] = useState(false);
  const fileInputRef = useRef(null);
  const cameraInputRef = useRef(null);

  // Show the "Add to Home Screen" hint only on iPhone/iPad Safari, and only
  // when the app isn't already installed (standalone). Android/Chrome gets a
  // native install prompt from the browser, so it doesn't need this.
  useEffect(() => {
    try {
      const ua = window.navigator.userAgent || "";
      const isIos = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
      const isStandalone =
        window.matchMedia?.("(display-mode: standalone)")?.matches ||
        window.navigator.standalone === true;
      const dismissed = localStorage.getItem("ua_ios_hint_dismissed") === "1";
      if (isIos && !isStandalone && !dismissed) setShowIosHint(true);
    } catch (e) {
      /* no-op */
    }
  }, []);

  const dismissIosHint = () => {
    setShowIosHint(false);
    try {
      localStorage.setItem("ua_ios_hint_dismissed", "1");
    } catch (e) {
      /* no-op */
    }
  };

  const MAX_PHOTOS = 6;

  // Owner-only cost readout. Visit the site with ?debug=cost in the URL to
  // see the real API cost of each valuation. Testers/customers never see it.
  const showCost = (() => {
    try {
      return new URLSearchParams(window.location.search).get("debug") === "cost";
    } catch {
      return false;
    }
  })();

  const handleFiles = (fileList) => {
    if (!fileList || fileList.length === 0) return;
    setError(null);
    setResult(null);
    const files = Array.from(fileList);

    // Resize + compress each photo in the browser BEFORE upload.
    // Phone photos are multi-MB; base64 adds ~33% on top, which blows past
    // Netlify's request-size limit and makes the POST fail before the
    // function even runs. We cap the long edge at 1024px and re-encode as
    // JPEG ~0.8 — plenty to read marks/condition, a few hundred KB each.
    const MAX_EDGE = 1024;
    const QUALITY = 0.8;

    const processFile = (file) =>
      new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const dataUrl = ev.target.result;
          if (typeof dataUrl !== "string" || dataUrl.indexOf(",") === -1) {
            resolve(null);
            return;
          }
          const img = new Image();
          img.onload = () => {
            let { width, height } = img;
            if (width > MAX_EDGE || height > MAX_EDGE) {
              if (width >= height) {
                height = Math.round((height * MAX_EDGE) / width);
                width = MAX_EDGE;
              } else {
                width = Math.round((width * MAX_EDGE) / height);
                height = MAX_EDGE;
              }
            }
            const canvas = document.createElement("canvas");
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(img, 0, 0, width, height);
            const outUrl = canvas.toDataURL("image/jpeg", QUALITY);
            const base64 = outUrl.split(",")[1];
            resolve({ src: outUrl, data: base64, mediaType: "image/jpeg" });
          };
          img.onerror = () => resolve(null);
          img.src = dataUrl;
        };
        reader.onerror = () => resolve(null);
        reader.readAsDataURL(file);
      });

    (async () => {
      const results = [];
      for (const file of files) {
        const out = await processFile(file);
        if (out) results.push(out);
      }
      if (results.length === 0) {
        setError("One of the photos couldn't be read. Try a different image.");
        return;
      }
      setPhotos((prev) => {
        const room = MAX_PHOTOS - prev.length;
        if (room <= 0) return prev;
        return [...prev, ...results.slice(0, room)];
      });
    })();
  };

  const removePhoto = (i) => {
    setPhotos((prev) => prev.filter((_, idx) => idx !== i));
    setResult(null);
  };

  const evaluate = async () => {
    if (photos.length === 0) return;
    setLoading(true);
    setError(null);
    setResult(null);
    setCostInfo(null);

    resetTrack();
    setLoadingMsg(NEUTRAL_OPENER);

    const jobId =
      "job_" + Date.now() + "_" + Math.random().toString(36).slice(2, 10);

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    try {
      // 1) Upload each photo to Blobs ONE AT A TIME (via upload.js).
      // One photo per request stays well under the 6MB regular-function
      // limit. The background function reads them back out of Blobs, so the
      // big image data never travels through the background function's tiny
      // 256KB request limit. This is the fix for "couldn't start."
      for (let i = 0; i < photos.length; i++) {
        const upRes = await fetch("/.netlify/functions/upload", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            jobId,
            index: i,
            data: photos[i].data,
            mediaType: photos[i].mediaType,
          }),
        });
        if (!upRes.ok) {
          setError("Couldn't upload the photos. Try again.");
          clearTimers();
          setLoading(false);
          return;
        }
      }

      // 2) Kick off the background valuation with a TINY payload —
      // just the jobId, how many photos, and the text fields.
      const startRes = await fetch(
        "/.netlify/functions/start-valuation-background",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            jobId,
            photoCount: photos.length,
            notes: notes.trim(),
            mode,
            zip: zip.trim(),
          }),
        }
      );
      // Background functions return 202 Accepted; anything else is a problem
      if (startRes.status !== 202 && !startRes.ok) {
        setError("Couldn't start the valuation. Try again.");
        clearTimers();
        setLoading(false);
        return;
      }

      // 2) Poll for the result (background job can take up to ~2 min)
      const maxTries = 90; // ~135s at 1.5s intervals
      let parsed = null;
      let failMsg = null;

      for (let i = 0; i < maxTries; i++) {
        await sleep(1500);
        let poll;
        try {
          poll = await fetch(
            `/.netlify/functions/result?jobId=${encodeURIComponent(jobId)}`
          );
        } catch {
          continue; // transient network hiccup — keep polling
        }
        if (!poll.ok) continue;
        const pd = await poll.json();
        // Consent gate: triage thinks this might be collectible. Pause and
        // let the user choose deeper vs. quick before spending the expensive lane.
        if (pd.status === "awaiting_consent") {
          clearTimers();
          setLoading(false);
          setConsent({ jobId, photoCount: photos.length });
          return;
        }
        // As soon as the fast triage verdict lands, switch to the right
        // message track (common = quick/neutral, collectible = deeper).
        if (pd.klass) applyTrack(pd.klass);
        if (pd.status === "done" && pd.result) {
          parsed = pd.result;
          if (pd.cost) setCostInfo(pd.cost);
          break;
        }
        if (pd.status === "error") {
          failMsg = pd.error || "The valuation couldn't be completed.";
          break;
        }
        // status "pending" → keep polling
      }

      if (failMsg) {
        setError(failMsg + " Try again.");
      } else if (!parsed) {
        setError("This is taking longer than expected. Please try again.");
      } else {
        setResult(parsed);
      }
    } catch (err) {
      setError(`Something went wrong: ${err.message}. Try again.`);
    } finally {
      clearTimers();
      setLoading(false);
    }
  };

  // Shared polling loop — used by both the initial evaluate and consent resume.
  const pollForResult = async (jobId) => {
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const maxTries = 90;
    let parsed = null;
    let failMsg = null;
    for (let i = 0; i < maxTries; i++) {
      await sleep(1500);
      let poll;
      try {
        poll = await fetch(
          `/.netlify/functions/result?jobId=${encodeURIComponent(jobId)}`
        );
      } catch {
        continue;
      }
      if (!poll.ok) continue;
      const pd = await poll.json();
      if (pd.klass) applyTrack(pd.klass);
      if (pd.status === "done" && pd.result) {
        parsed = pd.result;
        if (pd.cost) setCostInfo(pd.cost);
        break;
      }
      if (pd.status === "error") {
        failMsg = pd.error || "The valuation couldn't be completed.";
        break;
      }
    }
    if (failMsg) setError(failMsg + " Try again.");
    else if (!parsed) setError("This is taking longer than expected. Please try again.");
    else setResult(parsed);
  };

  // User answered the consent prompt: re-invoke the valuation with the chosen lane.
  const resumeWithLane = async (lane) => {
    if (!consent) return;
    const { jobId, photoCount } = consent;
    setConsent(null);
    setLoading(true);
    setError(null);
    setResult(null);
    setCostInfo(null);
    // Set the right wait-message track immediately based on the choice.
    resetTrack();
    applyTrack(lane === "collectible" ? "collectible" : "common");
    try {
      const res = await fetch(
        "/.netlify/functions/start-valuation-background",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            jobId,
            photoCount,
            notes: notes.trim(),
            mode,
            zip: zip.trim(),
            forceLane: lane,
          }),
        }
      );
      if (res.status !== 202 && !res.ok) {
        setError("Couldn't start the valuation. Try again.");
        clearTimers();
        setLoading(false);
        return;
      }
      await pollForResult(jobId);
    } catch (err) {
      setError(`Something went wrong: ${err.message}. Try again.`);
    } finally {
      clearTimers();
      setLoading(false);
    }
  };

  const reset = () => {
    setPhotos([]);
    setNotes("");
    setResult(null);
    setError(null);
    setConsent(null);
    setCostInfo(null);
  };

  const isSell = mode === "sell";

  const handlePrint = () => {
    window.print();
  };

  // Compute a wholesale (dealer-buy) range from a value range string when the
  // model omits it. Parses "$40–65" / "$40-65" / "$40 to 65" → 45-55% of each end.
  const deriveWholesale = (valueStr) => {
    if (!valueStr || typeof valueStr !== "string") return null;
    const nums = valueStr.replace(/,/g, "").match(/\d+(\.\d+)?/g);
    if (!nums || nums.length === 0) return null;
    const lo = parseFloat(nums[0]);
    const hi = nums.length > 1 ? parseFloat(nums[1]) : lo;
    if (!isFinite(lo) || !isFinite(hi)) return null;
    const wLo = Math.round((lo * 0.45) / 5) * 5;
    const wHi = Math.round((hi * 0.55) / 5) * 5;
    if (wLo <= 0 && wHi <= 0) return null;
    return wLo === wHi ? `$${wHi}` : `$${wLo}–${wHi}`;
  };

  return (
    <div style={S.page}>
      <style>{keyframes}</style>
      <div style={S.frame}>
        <header style={S.header}>
          <div style={S.eyebrow}>BUY LOW · SELL HIGH</div>
          <h1 style={S.title}>Unfair Advantage</h1>
          <div style={S.aiTag}>
            <div>AI-Powered</div>
            <div>Real-Time Market Research</div>
          </div>
          <p style={S.sub}>
            Price range estimates from real sales data.
          </p>
          <p style={S.subBold}>Knowledge is power.</p>
        </header>

        {showIosHint && (
          <div style={S.iosHint}>
            <div style={S.iosHintText}>
              <strong>Add to your home screen:</strong> tap the Share button{" "}
              <span style={S.iosShareGlyph} aria-hidden="true">
                &#x2191;
              </span>{" "}
              below, then <strong>Add to Home Screen</strong> — opens like an app, no download.
            </div>
            <button
              style={S.iosHintClose}
              onClick={dismissIosHint}
              aria-label="Dismiss"
            >
              &times;
            </button>
          </div>
        )}

        {/* Mode toggle */}
        <div style={S.toggle}>
          <button
            style={{ ...S.toggleBtn, ...(isSell ? S.toggleActive : {}) }}
            onClick={() => {
              setMode("sell");
              setResult(null);
            }}
          >
            I'm selling
          </button>
          <button
            style={{ ...S.toggleBtn, ...(!isSell ? S.toggleActive : {}) }}
            onClick={() => {
              setMode("buy");
              setResult(null);
            }}
          >
            I'm buying
          </button>
        </div>

        {/* Library picker: opens photo gallery, allows multiple */}
        <input
          ref={fileInputRef}
          type="file"
          accept="image/*"
          multiple
          style={{ display: "none" }}
          onChange={(e) => {
            handleFiles(e.target.files);
            e.target.value = "";
          }}
        />

        {/* Camera: opens the rear camera directly, one shot at a time */}
        <input
          ref={cameraInputRef}
          type="file"
          accept="image/*"
          capture="environment"
          style={{ display: "none" }}
          onChange={(e) => {
            handleFiles(e.target.files);
            e.target.value = "";
          }}
        />

        {photos.length === 0 && (
          <div
            style={{ ...S.dropzone, ...(dragActive ? S.dropzoneActive : {}) }}
            onDragEnter={(e) => {
              e.preventDefault();
              setDragActive(true);
            }}
            onDragOver={(e) => {
              e.preventDefault();
              setDragActive(true);
            }}
            onDragLeave={(e) => {
              e.preventDefault();
              if (!e.currentTarget.contains(e.relatedTarget)) {
                setDragActive(false);
              }
            }}
            onDrop={(e) => {
              e.preventDefault();
              setDragActive(false);
              handleFiles(e.dataTransfer.files);
            }}
          >
            {dragActive ? (
              <div style={{ ...S.dropText, pointerEvents: "none" }}>
                Drop to add
              </div>
            ) : (
              <>
                <div style={S.photoBtnRow}>
                  <button
                    style={S.photoBtnPrimary}
                    onClick={() => cameraInputRef.current?.click()}
                  >
                    📷 Take Photo
                  </button>
                  <button
                    style={S.photoBtnSecondary}
                    onClick={() => fileInputRef.current?.click()}
                  >
                    🖼 Choose from Library
                  </button>
                </div>
                <div style={{ ...S.dropHint, pointerEvents: "none", marginTop: 12 }}>
                  <span style={S.dropHintMain}>Add several angles: the overall item, the underside/maker's mark or signature if any, any damage, and a size reference (a coin or tape measure).</span>
                  <br /><br />
                  <span style={{ fontWeight: 700 }}>On a computer, you can also drag &amp; drop photos anywhere in this box.</span>
                </div>
              </>
            )}
          </div>
        )}

        {photos.length > 0 && (
          <div
            style={S.workspace}
            onDragEnter={(e) => {
              e.preventDefault();
              setDragActive(true);
            }}
            onDragOver={(e) => {
              e.preventDefault();
              setDragActive(true);
            }}
            onDragLeave={(e) => {
              e.preventDefault();
              if (!e.currentTarget.contains(e.relatedTarget)) {
                setDragActive(false);
              }
            }}
            onDrop={(e) => {
              e.preventDefault();
              setDragActive(false);
              handleFiles(e.dataTransfer.files);
            }}
          >
            <div style={S.thumbGrid}>
              {photos.map((p, i) => (
                <div key={i} style={S.thumbWrap}>
                  <img src={p.src} alt={`view ${i + 1}`} style={S.thumb} />
                  <button
                    style={S.thumbRemove}
                    onClick={() => removePhoto(i)}
                    aria-label="Remove"
                  >
                    ×
                  </button>
                </div>
              ))}
            </div>

            {photos.length < MAX_PHOTOS && (
              <div style={S.photoBtnRow}>
                <button
                  style={S.photoBtnPrimary}
                  onClick={() => cameraInputRef.current?.click()}
                >
                  📷 Take Another Photo
                </button>
                <button
                  style={S.photoBtnSecondary}
                  onClick={() => fileInputRef.current?.click()}
                >
                  🖼 Add from Library
                </button>
              </div>
            )}
            {photos.length >= MAX_PHOTOS && (
              <div style={{ ...S.dropHint, textAlign: "center", marginTop: 4 }}>
                Maximum {MAX_PHOTOS} photos.
              </div>
            )}

            {!consent && !loading && (
              <>
                <div style={S.fieldRow}>
                  <div style={S.zipField}>
                    <label style={S.zipLabel}>
                      {isSell ? "Your sale's ZIP code" : "ZIP code of the sale"}{" "}
                      <span style={S.zipLabelOptional}><strong style={{ textTransform: "uppercase", letterSpacing: "0.03em" }}>Optional</strong> — helps price local items</span>
                    </label>
                    <input
                      style={S.zipInput}
                      value={zip}
                      onChange={(e) =>
                        setZip(e.target.value.replace(/\D/g, "").slice(0, 5))
                      }
                      placeholder="e.g. 37421"
                      inputMode="numeric"
                    />
                  </div>
                </div>

                <label style={S.notesLabel}>
                  Anything a photo can't show?
                  <span style={S.notesHint}>
                    Marks, chips, dimensions — and for odd items, who might want it
                    (e.g. "local shop still buys these").
                  </span>
                </label>
                <textarea
                  style={S.notes}
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="e.g. small chip on rim, 9in wide, mark reads 'Roseville'"
                  rows={3}
                />
              </>
            )}

            {loading && (
              <div style={S.loadingCard}>
                <div style={S.loadingSpinner} />
                <div style={S.loadingText}>{loadingMsg}</div>
              </div>
            )}

            {consent && !loading && (
              <div style={S.consentCard}>
                <div style={S.consentTitle}>Take a closer look?</div>
                <div style={S.consentBody}>
                  This item may be collectible — worth more than a quick glance
                  shows. A deeper search of real sold prices pins down its true value.
                </div>
                <div style={S.consentBtnRow}>
                  <button
                    style={S.consentPrimary}
                    onClick={() => resumeWithLane("collectible")}
                  >
                    Deeper research · 4 tokens
                    <span style={S.consentBtnSub}>Recommended for marked or unusual items</span>
                  </button>
                  <button
                    style={S.consentSecondary}
                    onClick={() => resumeWithLane("common")}
                  >
                    Quick estimate · 1 token
                    <span style={S.consentBtnSubDark}>Everyday items only — won't research collectible value</span>
                  </button>
                </div>
              </div>
            )}

            {!result && !consent && (
              <button style={S.evalBtn} onClick={evaluate} disabled={loading}>
                {loading
                  ? "Working…"
                  : isSell
                  ? "What can I get for this?"
                  : "Is this a good deal?"}
              </button>
            )}
            {result && (
              <button style={S.changeBtnInline} onClick={reset}>
                New Search
              </button>
            )}
          </div>
        )}

        {error && <div style={S.error}>{error}</div>}

        {result && (
          <div style={S.result} id="ua-report">
            {/* Print-only header: title, date, and photos for the record */}
            <div className="print-only" style={S.printHeader}>
              <div style={S.printTitle}>Unfair Advantage — Valuation Report</div>
              <div style={S.printDate}>
                {new Date().toLocaleDateString(undefined, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
                {isSell ? " · Selling" : " · Buying"}
                {zip.trim() ? ` · ZIP ${zip.trim()}` : ""}
              </div>
              {photos.length > 0 && (
                <div style={S.printPhotos}>
                  {photos.map((p, i) => (
                    <img key={i} src={p.src} alt="" style={S.printPhoto} />
                  ))}
                </div>
              )}
            </div>

            <div style={S.idBlock}>
              <div style={S.idHeadRow}>
                <div style={S.idLabel}>What it is</div>
                {result.confidence && (
                  <span style={{ ...S.confBadge, ...confStyle(result.confidence) }}>
                    {result.confidence} confidence
                  </span>
                )}
              </div>
              <div style={S.idText}>{result.id}</div>
              {result.itemType && typeLabel[result.itemType] && (
                <div style={S.typeTag}>
                  <span style={S.typeTagLabel}>BEST MARKET: </span>
                  {typeLabel[result.itemType]}
                </div>
              )}
            </div>

            {/* Primary number depends on mode */}
            <div style={S.priceRow}>
              <div style={{ ...S.priceCard, ...S.priceCardValue }}>
                <div style={S.priceLabel}>
                  {isSell ? "Asking Price" : "Don't pay over"}
                </div>
                <div style={S.priceValueBig}>
                  {isSell ? result.listPrice : result.walkAway}
                </div>
              </div>
              <div style={S.priceCard}>
                <div style={S.priceLabel}>Market Value</div>
                <div style={S.priceValueBuy}>{result.value}</div>
              </div>
              {isSell && (result.wholesale || deriveWholesale(result.value)) && (
                <div style={S.priceCard}>
                  <div style={S.priceLabel}>Wholesale</div>
                  <div style={S.priceValueBuy}>
                    {result.wholesale || deriveWholesale(result.value)}
                  </div>
                </div>
              )}
            </div>

            {/* Conditional breakdown of the wide range into tighter scenarios */}
            {Array.isArray(result.scenarios) && result.scenarios.length > 0 && (
              <div style={S.scenarioWrap}>
                <div style={S.scenarioIntro}>
                  Narrow it down — which is true?
                </div>
                {result.scenarios.map((sc, i) => (
                  <div key={i} style={S.scenarioBlock}>
                    <div style={S.scenarioCond}>{sc.condition}</div>
                    <div style={S.scenarioPriceRow}>
                      <div style={S.scenarioCard}>
                        <div style={S.scenarioPriceLabel}>
                          {isSell ? "Asking Price" : "Don't pay over"}
                        </div>
                        <div style={S.scenarioValueBig}>
                          {isSell ? sc.listPrice : sc.walkAway}
                        </div>
                      </div>
                      <div style={S.scenarioCard}>
                        <div style={S.scenarioPriceLabel}>Market Value</div>
                        <div style={S.scenarioValueBuy}>{sc.value}</div>
                      </div>
                      {isSell && (sc.wholesale || deriveWholesale(sc.value)) && (
                        <div style={S.scenarioCard}>
                          <div style={S.scenarioPriceLabel}>Wholesale</div>
                          <div style={S.scenarioValueBuy}>
                            {sc.wholesale || deriveWholesale(sc.value)}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Mode-specific advice — the "advantage" */}
            <div style={S.adviceBox}>
              <div style={S.adviceLabel}>
                {isSell ? "★ How to get top dollar" : "★ How to win the negotiation"}
              </div>
              <PointList points={toPoints(result.advice)} color="#5a3d0e" />
            </div>

            <div style={S.section}>
              <div style={S.sectionLabel}>How these numbers were reached</div>
              <PointList points={toPoints(result.reasoning)} color="#1c1a17" />
            </div>

            <div style={S.cantVerify}>
              <div style={S.cantLabel}>⚠ What could move this price</div>
              <PointList points={toPoints(result.cantVerify)} color="#5a2020" />
            </div>

            <div style={S.disclaimer}>
              <strong>Estimate only — not an appraisal.</strong> Rough estimate
              based on available market data, which may be limited for unusual
              items. Condition, authenticity, and maker can't be verified from a
              photo. Your decisions are your own.
            </div>

            <div
              className="no-print"
              style={{ marginTop: 20, textAlign: "center" }}
            >
              <button
                style={S.printBtn}
                onClick={handlePrint}
              >
                🖨 Print / Save as PDF
              </button>
            </div>

            {showCost && costInfo && (
              <div className="no-print" style={S.costBox}>
                <div style={S.costTitle}>
                  API cost this run: <strong>${costInfo.total.toFixed(4)}</strong>
                </div>
                <div style={S.costLine}>
                  {costInfo.inputTokens.toLocaleString()} in · {costInfo.outputTokens.toLocaleString()} out · {costInfo.searches} search{costInfo.searches === 1 ? "" : "es"}
                </div>
                <div style={S.costLine}>
                  tokens ${(costInfo.inCost + costInfo.outCost).toFixed(4)} · search ${costInfo.searchCost.toFixed(4)}
                </div>
                <div style={S.costLine}>
                  Break-even at $9.99/mo: ~{Math.floor(9.99 / costInfo.total)} runs · $19.99: ~{Math.floor(19.99 / costInfo.total)} · $24.99: ~{Math.floor(24.99 / costInfo.total)}
                </div>
              </div>
            )}

            <div
              className="no-print"
              style={{ marginTop: 18, textAlign: "center" }}
            >
              <button style={S.changeBtnInline} onClick={reset}>
                New Search
              </button>
            </div>
          </div>
        )}

        <footer style={S.footer}>
          Estimates only, not a certified appraisal. Based on available market
          data, which may be limited for rare items. Confirm condition and marks
          in hand.
        </footer>
      </div>
    </div>
  );
}

const keyframes = `
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  .print-only { display: none; }
  @media print {
    .no-print { display: none !important; }
    .print-only { display: block !important; }
    body * { visibility: hidden; }
    #ua-report, #ua-report * { visibility: visible; }
    #ua-report { position: absolute; left: 0; top: 0; width: 100%; padding: 0; margin: 0; }
    @page { margin: 0.5in; }
  }
`;

// ── Design tokens: dealer's field notebook — light paper, oxblood ink, verdigris ──
const ink = "#1c1a17";
const paper = "#faf7f0";
const paperDeep = "#f1ece0";
const oxblood = "#7c2d2d";
const verdigris = "#3f6f5f";
const brass = "#9a7b3f";
const faint = "#6b6456";

const S = {
  page: {
    minHeight: "100vh",
    background: "#fbfaf7",
    display: "flex",
    justifyContent: "center",
    padding: "24px 16px 48px",
    fontFamily: "Georgia, 'Times New Roman', serif",
    color: ink,
  },
  frame: { width: "100%", maxWidth: 460 },
  header: { marginBottom: 18, textAlign: "center" },
  eyebrow: {
    fontFamily: "'Courier New', monospace",
    fontSize: 15,
    letterSpacing: "0.18em",
    color: "#6f5620",
    fontWeight: 800,
    marginBottom: 12,
  },
  title: {
    fontSize: 38,
    lineHeight: 1.02,
    margin: "0 0 6px",
    fontWeight: 700,
    letterSpacing: "-0.02em",
  },
  aiTag: {
    fontSize: 19,
    fontWeight: 800,
    color: verdigris,
    letterSpacing: "0.01em",
    margin: "0 0 12px",
    fontFamily: "Georgia, serif",
    lineHeight: 1.25,
  },
  sub: { fontSize: 16, lineHeight: 1.5, color: "#33302a", margin: 0 },
  subBold: {
    fontSize: 17,
    lineHeight: 1.4,
    color: ink,
    fontWeight: 700,
    margin: "8px 0 0",
  },
  iosHint: {
    display: "flex",
    alignItems: "flex-start",
    gap: 10,
    background: "rgba(63,111,95,0.08)",
    border: `1px solid ${verdigris}`,
    borderRadius: 8,
    padding: "11px 12px",
    margin: "0 0 16px",
  },
  iosHintText: {
    flex: 1,
    fontSize: 13,
    lineHeight: 1.45,
    color: ink,
  },
  iosShareGlyph: {
    display: "inline-block",
    fontWeight: 700,
    color: verdigris,
    border: `1px solid ${verdigris}`,
    borderRadius: 4,
    padding: "0 5px",
    lineHeight: 1.5,
  },
  iosHintClose: {
    flexShrink: 0,
    background: "transparent",
    border: "none",
    color: faint,
    fontSize: 20,
    lineHeight: 1,
    cursor: "pointer",
    padding: "0 2px",
  },
  toggle: {
    display: "flex",
    gap: 6,
    background: "#ffffff",
    border: `1px solid ${paperDeep}`,
    borderRadius: 6,
    padding: 4,
    marginBottom: 20,
  },
  toggleBtn: {
    flex: 1,
    padding: "11px",
    border: "none",
    borderRadius: 4,
    background: "transparent",
    color: faint,
    fontSize: 15,
    fontWeight: 700,
    cursor: "pointer",
    fontFamily: "Georgia, serif",
    transition: "all 0.15s",
  },
  toggleActive: { background: ink, color: paper },
  dropzone: {
    border: `1.5px dashed ${brass}`,
    borderRadius: 4,
    padding: "32px 20px",
    textAlign: "center",
    background: "#ffffff",
    transition: "background 0.15s, border-color 0.15s",
    minHeight: 180,
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    justifyContent: "center",
  },
  dropzoneActive: {
    background: "rgba(63,111,95,0.14)",
    borderColor: verdigris,
    borderStyle: "solid",
  },
  dropMark: { fontSize: 40, color: brass, lineHeight: 1, marginBottom: 12 },
  dropText: { fontSize: 17, fontWeight: 700 },
  dropHint: { fontSize: 14, color: "#4a463d", marginTop: 4, lineHeight: 1.5 },
  dropHintMain: { fontWeight: 700, color: "#33302a" },
  photoBtnRow: {
    display: "flex",
    flexWrap: "wrap",
    gap: 10,
    justifyContent: "center",
    margin: "8px 0 0",
  },
  photoBtnPrimary: {
    flex: "1 1 auto",
    minWidth: 150,
    padding: "14px 20px",
    borderRadius: 6,
    border: "none",
    background: verdigris,
    color: "#ffffff",
    fontSize: 16,
    fontWeight: 700,
    cursor: "pointer",
  },
  photoBtnSecondary: {
    flex: "1 1 auto",
    minWidth: 150,
    padding: "14px 20px",
    borderRadius: 6,
    border: `1.5px solid ${verdigris}`,
    background: "#ffffff",
    color: verdigris,
    fontSize: 16,
    fontWeight: 700,
    cursor: "pointer",
  },
  workspace: { animation: "rise 0.3s ease" },
  thumbGrid: {
    display: "grid",
    gridTemplateColumns: "repeat(3, 1fr)",
    gap: 8,
    marginBottom: 14,
