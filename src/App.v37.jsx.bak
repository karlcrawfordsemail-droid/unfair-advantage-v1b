    fontSize: 10.5,
    letterSpacing: "0.1em",
    color: "#5a5346",
    fontWeight: 700,
    textTransform: "uppercase",
    marginBottom: 2,
  },
  zipInput: {
    padding: "10px 12px",
    borderRadius: 4,
    border: `1px solid ${brass}`,
    background: "#ffffff",
    fontSize: 16,
    fontFamily: "'Courier New', monospace",
    color: ink,
    letterSpacing: "0.08em",
  },
  notesLabel: { display: "block", fontSize: 15, fontWeight: 700, marginBottom: 6 },
  notesHint: {
    display: "block",
    fontSize: 12.5,
    fontWeight: 400,
    color: faint,
    marginTop: 2,
  },
  notes: {
    width: "100%",
    boxSizing: "border-box",
    padding: 12,
    borderRadius: 4,
    border: `1px solid ${brass}`,
    background: "#ffffff",
    fontSize: 15,
    fontFamily: "Georgia, serif",
    resize: "vertical",
    marginBottom: 18,
    color: ink,
  },
  evalBtn: {
    width: "100%",
    padding: "15px",
    background: oxblood,
    color: paper,
    border: "none",
    borderRadius: 4,
    fontSize: 16,
    fontWeight: 700,
    cursor: "pointer",
    fontFamily: "Georgia, serif",
    letterSpacing: "0.02em",
  },
  consentCard: {
    background: "#fdf0d5",
    border: `2.5px solid ${oxblood}`,
    borderRadius: 8,
    padding: "18px 18px 20px",
    marginBottom: 14,
    boxShadow: "0 2px 12px rgba(124,45,45,0.15)",
  },
  consentTitle: {
    fontSize: 20,
    fontWeight: 800,
    color: oxblood,
    marginBottom: 8,
    fontFamily: "Georgia, serif",
  },
  consentBody: {
    fontSize: 14.5,
    lineHeight: 1.5,
    color: "#33302a",
    marginBottom: 16,
  },
  consentBtnRow: {
    display: "flex",
    flexWrap: "wrap",
    gap: 10,
  },
  consentPrimary: {
    flex: "1 1 auto",
    minWidth: 160,
    padding: "14px 18px",
    background: verdigris,
    color: "#ffffff",
    border: "none",
    borderRadius: 6,
    fontSize: 15,
    fontWeight: 700,
    cursor: "pointer",
    fontFamily: "Georgia, serif",
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    gap: 3,
  },
  consentRecommended: {
    fontSize: 11,
    fontWeight: 700,
    textTransform: "uppercase",
    letterSpacing: "0.08em",
    opacity: 0.9,
  },
  consentBtnSub: {
    fontSize: 11.5,
    fontWeight: 700,
    letterSpacing: "0.02em",
    opacity: 0.95,
    lineHeight: 1.3,
  },
  consentBtnSubDark: {
    fontSize: 11.5,
    fontWeight: 700,
    letterSpacing: "0.02em",
    lineHeight: 1.3,
    color: "#ffffff",
    opacity: 0.92,
  },
  consentSecondary: {
    flex: "1 1 auto",
    minWidth: 160,
    padding: "14px 18px",
    background: "#6b6456",
    color: "#ffffff",
    border: "none",
    borderRadius: 6,
    fontSize: 15,
    fontWeight: 700,
    cursor: "pointer",
    fontFamily: "Georgia, serif",
    display: "flex",
    flexDirection: "column",
    alignItems: "center",
    gap: 4,
  },
  loadingCard: {
    marginBottom: 14,
    padding: "18px 16px",
    borderRadius: 6,
    background: "rgba(63,111,95,0.1)",
    border: `1px solid ${verdigris}`,
    display: "flex",
    alignItems: "center",
    gap: 14,
    animation: "rise 0.3s ease",
  },
  loadingSpinner: {
    flexShrink: 0,
    width: 22,
    height: 22,
    borderRadius: "50%",
    border: `3px solid rgba(63,111,95,0.25)`,
    borderTopColor: verdigris,
    animation: "spin 0.8s linear infinite",
  },
  loadingText: {
    fontSize: 15,
    lineHeight: 1.4,
    color: "#2c5346",
    fontWeight: 700,
  },
  changeBtnInline: {
    width: "100%",
    marginTop: 14,
    padding: "14px",
    background: ink,
    color: paper,
    border: `1.5px solid ${ink}`,
    borderRadius: 4,
    fontSize: 15,
    fontWeight: 700,
    cursor: "pointer",
    fontFamily: "Georgia, serif",
    letterSpacing: "0.02em",
  },
  error: {
    marginTop: 18,
    padding: 14,
    background: "rgba(124,45,45,0.08)",
    border: `1px solid ${oxblood}`,
    borderRadius: 4,
    color: oxblood,
    fontSize: 14,
  },
  result: { marginTop: 22, animation: "rise 0.35s ease" },
  idBlock: { borderLeft: `3px solid ${brass}`, paddingLeft: 14, marginBottom: 20 },
  idHeadRow: {
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between",
    gap: 8,
    marginBottom: 5,
  },
  confBadge: {
    fontFamily: "'Courier New', monospace",
    fontSize: 10.5,
    fontWeight: 700,
    letterSpacing: "0.06em",
